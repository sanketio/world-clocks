{
	"name": "@sanketio/world-clocks",
	"version": "1.0.3",
	"description": "Enable world clocks for the sites with different timezones, with a custom block for the WordPress block editor (Gutenberg).",
	"homepage": "https://github.com/sanketio/world-clocks#readme",
	"license": "GPL-2.0-or-later",
	"author": {
		"name": "Sanket Parmar",
		"email": "sanket.parmar11@gmail.com",
		"url": "https://sanketio.github.io/",
		"role": "developer"
	},
	"bugs": {
		"url": "https://github.com/sanketio/world-clocks/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sanketio/world-clocks.git"
	},
	"keywords": [
		"clock",
		"watch",
		"time",
		"timezone"
	],
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"archive": "composer archive --file=world-clocks --format=zip",
		"postarchive": "rm -rf world-clocks && unzip world-clocks.zip -d world-clocks && rm world-clocks.zip && zip -r world-clocks.zip world-clocks && rm -rf world-clocks",
		"precommit": "npm run lint-php && npm run lint-style && npm run lint-js",
		"prepare": "husky install",
		"lint-js": "wp-scripts lint-js",
		"lint-style": "wp-scripts lint-style --allow-empty-input",
		"lint-php": "./vendor/bin/phpcs --standard=phpcs.xml -p -s .",
		"clean-dist": "rm -rf dist",
		"clean-npm-dependency": "rm -rf node_modules",
		"clean-composer-dependency": "rm -rf vendor",
		"clean-all": "npm run clean-composer-dependency && npm run clean-npm-dependency && npm run clean-dist"
	},
	"devDependencies": {
		"@babel/core": "^7.29.6",
		"@babel/eslint-parser": "^7.28.6",
		"@babel/preset-react": "^7.28.5",
		"@stylistic/stylelint-plugin": "^5.0.1",
		"@wordpress/date": "^5.40.0",
		"@wordpress/eslint-plugin": "^24.2.0",
		"@wordpress/keycodes": "^4.40.0",
		"@wordpress/scripts": "^31.5.0",
		"clsx": "^2.1.1",
		"eslint": "^8.57.0",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jest": "^28.6.0",
		"eslint-plugin-jsdoc": "^62.7.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^4.6.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.8.1",
		"stylelint": "^17.3.0",
		"stylelint-config-recommended": "^18.0.0",
		"stylelint-declaration-strict-value": "^1.11.1",
		"stylelint-order": "^7.0.1"
	},
	"overrides": {
		"@babel/core": "^7.29.6",
		"@babel/plugin-transform-modules-systemjs@7": "7.29.4",
		"@opentelemetry/core": "2.8.0",
		"adm-zip@0": "0.6.0",
		"axios@1": "1.18.0",
		"basic-ftp@5": "5.3.1",
		"body-parser@1": "1.20.6",
		"brace-expansion@1": "1.1.18",
		"brace-expansion@2": "2.1.4",
		"fast-uri@3": "3.1.5",
		"flatted@3": "3.4.2",
		"follow-redirects@1": "1.16.0",
		"form-data@4": "4.0.6",
		"http-proxy-middleware@2": "2.0.10",
		"immutable@5": "5.1.8",
		"ip-address@10": "10.3.1",
		"joi@18": "18.2.1",
		"js-yaml@3": "3.15.1",
		"js-yaml@4": "4.3.1",
		"launch-editor@2": "2.14.1",
		"linkify-it": "5.0.2",
		"lodash-es@4": "4.18.1",
		"lodash@4": "4.18.1",
		"markdown-it": "14.2.0",
		"minimatch@3": "3.1.4",
		"minimatch@9": "9.0.7",
		"nanoid@3": "3.3.18",
		"node-forge@1": "1.4.0",
		"path-to-regexp@0": "0.1.13",
		"picomatch@2": "2.3.2",
		"picomatch@4": "4.0.4",
		"postcss@8": "8.5.23",
		"qs@6": "6.15.2",
		"serialize-javascript": "7.0.5",
		"shell-quote@1": "1.9.0",
		"svgo@3": "3.3.4",
		"uuid@8": "11.1.1",
		"webpack-dev-server@4": "6.0.0",
		"websocket-driver@0": "0.7.5",
		"ws@7": "7.5.11",
		"ws@8": "8.21.0",
		"yaml@1": "1.10.3",
		"yaml@2": "2.8.3"
	}
}
